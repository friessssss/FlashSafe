{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlashSafe",
  "version": "0.1.0",
  "identifier": "com.flashsafe.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlashSafe",
        "width": 920,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false
  },
  "plugins": {}
}
